# ── EchoTray configuration ─────────────────────────────────────────────────
# Copy this file to .env and edit to taste. Your .env is git-ignored and stays
# local. This file is the committed reference template.

# Whisper model size: tiny, base, small, medium, large-v3
#   base (~148MB) is the default, a good balance of speed and accuracy on CPU.
#   First run downloads the model from Hugging Face and caches it locally.
MODEL_SIZE=base

# Compute type: int8 = fastest on CPU (recommended). float16 is not supported
# (EchoTray always runs on CPU).
COMPUTE_TYPE=int8

# Number of CPU threads CTranslate2 uses for transcription. Lower = less memory
# and often faster on CPU (avoids thread thrash). 4 is a good laptop default.
CPU_THREADS=4

# Language code, or leave empty for auto-detect. e.g. en, de, fr, es
WHISPER_LANGUAGE=en

# Audio capture settings (do not change unless you know what you're doing)
SAMPLE_RATE=16000
CHANNELS=1

# Max recording length in seconds before auto-stop
MAX_RECORDING_SECONDS=300

# Delay between clipboard copy and simulated Ctrl+V (ms). Increase if paste is blank.
PASTE_DELAY_MS=100

# Where the Whisper model is stored. Defaults to ~/.local/share/echotray/models/
# (the app install dir). Change only if you want the model elsewhere.
#MODEL_DIR=~/.local/share/echotray/models

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFY_ON_READY=true
NOTIFY_ON_RECORDING=true
NOTIFY_ON_DONE=true
NOTIFY_ON_SKIPPED=true
NOTIFY_VERBOSE=false

# Debug logging. When true, verbose diagnostic lines ([RSS], [ICON], [STATE])
# are written to the log. Off by default so the log stays readable during
# normal use; enable only when diagnosing a state/icon/memory bug.
ECHOTRAY_DEBUG=false
